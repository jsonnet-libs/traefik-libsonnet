          withPath(path): { path: path },
          '#withPathPrefix':: d.fn(help='"PathPrefix specifies the path prefix of the operations to select."', args=[d.arg(name='pathPrefix', type=d.T.string)]),
          withPathPrefix(pathPrefix): { pathPrefix: pathPrefix },
          '#withPathRegex':: d.fn(help='"PathRegex specifies a regular expression pattern for matching operations based on their paths."', args=[d.arg(name='pathRegex', type=d.T.string)]),
          withPathRegex(pathRegex): { pathRegex: pathRegex },
        },
        '#withMatchers':: d.fn(help='"Matchers defines a list of alternative rules for matching OpenAPI operations."', args=[d.arg(name='matchers', type=d.T.array)]),
        withMatchers(matchers): { matchers: if std.isArray(v=matchers) then matchers else [matchers] },
        '#withMatchersMixin':: d.fn(help='"Matchers defines a list of alternative rules for matching OpenAPI operations."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='matchers', type=d.T.array)]),
        withMatchersMixin(matchers): { matchers+: if std.isArray(v=matchers) then matchers else [matchers] },
        '#withName':: d.fn(help='"Name is the name of the OperationSet to reference in APICatalogItems or ManagedSubscriptions."', args=[d.arg(name='name', type=d.T.string)]),
        withName(name): { name: name },
      },
      '#override':: d.obj(help='"Override holds data used to override OpenAPI specification."'),
      override: {
