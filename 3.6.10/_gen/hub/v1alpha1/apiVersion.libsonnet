        '#matchers':: d.obj(help='"Matchers defines a list of alternative rules for matching OpenAPI operations."'),
        matchers: {
          '#withMethods':: d.fn(help='"Methods specifies the HTTP methods to be included for selection."', args=[d.arg(name='methods', type=d.T.array)]),
          withMethods(methods): { methods: if std.isArray(v=methods) then methods else [methods] },
          '#withMethodsMixin':: d.fn(help='"Methods specifies the HTTP methods to be included for selection."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='methods', type=d.T.array)]),
