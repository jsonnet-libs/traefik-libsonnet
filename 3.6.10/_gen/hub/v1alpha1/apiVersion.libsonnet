        '#withServers':: d.fn(help='', args=[d.arg(name='servers', type=d.T.array)]),
        withServers(servers): { spec+: { openApiSpec+: { override+: { servers: if std.isArray(v=servers) then servers else [servers] } } } },
        '#withServersMixin':: d.fn(help='\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='servers', type=d.T.array)]),
        withServersMixin(servers): { spec+: { openApiSpec+: { override+: { servers+: if std.isArray(v=servers) then servers else [servers] } } } },
